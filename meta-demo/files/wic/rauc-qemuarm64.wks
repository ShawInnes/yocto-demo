# QEMU ARM64 RAUC A/B disk layout

# EFI System Partition
part /boot --source bootimg-efi --sourceparams="loader=grub-efi" --ondisk sda --fstype=vfat --use-uuid --label boot --active --align 1024 --size 128

# Root filesystem A
part / --source rootfs --ondisk sda --fstype=ext4 --use-uuid --label rootfsA --part-name rootfsA --align 1024 --size 1024

# Root filesystem B
part --ondisk sda --fstype=ext4 --label rootfsB --part-name rootfsB --align 1024 --size 1024

# Persistent data
part --ondisk sda --fstype=ext4 --use-uuid --label data --align 1024 --size 256

bootloader --ptable gpt --timeout=5
